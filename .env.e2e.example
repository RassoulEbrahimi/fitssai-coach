# Local Nutrition E2E harness (NUT-13A) — example only, no secrets.
#
# Copy to .env.e2e.local (gitignored) and fill in. Everything here is local:
# the harness only ever talks to the Firebase emulators of the demo project
# demo-fitssai, and refuses to start otherwise. See docs/dev/nutrition-e2e.md.

# Password of the seeded emulator accounts (at least 8 characters).
# Choose a throwaway value that you do not use anywhere else. Required by
# `npm run e2e:seed`; `npm run e2e:nutrition` generates a random one if unset.
E2E_NUTRITION_PASSWORD=

# Emulator host the app and scripts use. Default 127.0.0.1. For a phone on the
# same network, set this machine's private LAN address (for example
# 192.168.x.y); only loopback and private addresses are accepted.
E2E_EMULATOR_HOST=

# Port of the E2E dev server. Default 5180 (Vite's usual 8080 is the
# Firestore emulator's port).
E2E_CLIENT_PORT=

# Browser for Playwright: chrome (installed Google Chrome, the default),
# msedge, or chromium after `npx playwright install chromium`.
E2E_BROWSER_CHANNEL=

# The client's Firebase settings are NOT configured here. `npm run e2e:client`
# sets every VITE_FIREBASE_* value itself: VITE_FIREBASE_USE_EMULATORS=true,
# VITE_FIREBASE_PROJECT_ID=demo-fitssai, a placeholder API key and the emulator
# host. Never put the production project or a real API key into E2E settings.
