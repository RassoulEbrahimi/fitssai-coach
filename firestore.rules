// Firestore Security Rules for the FitssAI Coach project (fitssai-coach).
//
// Captured from the deployed production rules on 2026-08-27. The owner-access
// model below is that capture, unchanged. The one deliberate difference is the
// protection of authorization fields on /users/{userId}, which closes a
// privilege-escalation path: the previous `allow write` let a signed-in user
// set `role: "admin"` on their own profile straight from the client SDK.
//
// Since then, Nutrition has been carved out of the generic owner wildcard
// under /users/{userId}: Nutrition V2 (`nutrition_v2_*`) and legacy
// `nutrition_plans` are owner-readable and closed to client writes.
//
// Everything here is exercised by rules-tests/firestore.rules.test.ts against
// the real rules engine in the Firestore emulator. Those tests were first run
// against the captured production rules, where the eight role-escalation cases
// failed — the vulnerability, reproduced before it was fixed.
//
// Note: the Admin SDK, and therefore Cloud Functions, bypasses these rules
// entirely. Server-side code needs no allowance here, and these rules must
// never be loosened to accommodate it.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields that decide what someone is allowed to do. No client path writes
    // any of them — the app's profile writes are explicit field lists and
    // onboarding creates the document without a role — so a client write that
    // touches one did not come from the app.
    //
    // `role` is the field the app actually reads. The rest are the spellings a
    // future feature might reach for; listing them costs nothing and means the
    // rule does not have to be revisited to stay correct.
    function protectedFields() {
      return ['role', 'admin', 'isAdmin', 'roles', 'permissions'];
    }

    // Nutrition V2 owns every user subcollection whose name starts with
    // `nutrition_v2_`, today's six and any added later. Legacy Nutrition's
    // `nutrition_plans` is closed to client writes alongside it.
    //
    // Rules have no deny precedence: `allow` conditions on overlapping matches
    // are OR-combined, so an explicit read-only block below cannot take back a
    // write the generic owner wildcard already grants. The wildcard itself has
    // to leave these names out, and this predicate is how it does.
    function isNutritionV2Collection(name) {
      return name.matches('nutrition_v2_.*');
    }

    function isNutritionCollection(name) {
      return isNutritionV2Collection(name) || name == 'nutrition_plans';
    }

    // ---- Nutrition V2 recorded entries --------------------------------
    //
    // The persisted shape mirrors `recordedEntrySchema` in
    // shared/nutrition/contracts.ts; the client writes it only through the
    // shared planner (shared/nutrition/entryWrite.ts) inside a transaction.
    //
    // Rules own: authorization, the adult gate, document shape, identity,
    // the exact revision step, the intent-ring step, tombstones and no delete.
    // The planner owns what rules cannot see: whether an intent is a
    // duplicate (it is then not written at all), whether the revision the
    // person saw is still current (the transaction reads it), and that a
    // planned-meal estimate is the planned values times the portion.
    //
    // Deliberately not here: any date window. A future Berlin date is refused
    // by the client's Berlin calendar, and rules have no Berlin calendar to
    // compare with — a UTC approximation would be wrong around midnight. The
    // lower backfill bound is an open product decision and is not invented.

    // Nutrition V2 is for adults: the owner's own profile must hold a usable
    // numeric age of at least 18. Missing, malformed or under-18 is refused.
    // Reads are not gated here; the client hides V2 from ineligible accounts.
    function isNutritionAdult(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let age = exists(path) ? get(path).data.get('age', null) : null;
      return age is number && isFiniteNumber(age) && age >= 18;
    }

    function isNutritionSlotId(value) {
      return value in ['breakfast', 'lunch', 'snack_1', 'dinner', 'snack_2'];
    }

    function isNutritionDocId(value) {
      return value is string && value.matches('^[A-Za-z0-9-]{1,128}$');
    }

    // YYYY-MM-DD naming a real calendar day: a day that does not exist
    // (2026-02-30) either fails to build or comes back as another day.
    function isNutritionDate(value) {
      return value is string
             && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && isCalendarDay(value.split('-'));
    }

    function isCalendarDay(parts) {
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return day.year() == int(parts[0]) && day.month() == int(parts[1]) && day.day() == int(parts[2]);
    }

    function uuidPattern() {
      return '[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}';
    }

    // An applied intent id: a lower-case UUID.
    function isIntentId(value) {
      return value is string && value.matches('^' + uuidPattern() + '$');
    }

    // NaN and ±Infinity are the only numbers for which v - v is not 0.
    function isFiniteNumber(value) {
      return value - value == 0;
    }

    // A finite, non-negative number. Structure only: no nutrition bound.
    function isQuantity(value) {
      return value is number && isFiniteNumber(value) && value >= 0;
    }

    function isNutrientKeys(value) {
      return value is map
             && value.keys().hasOnly(['kcal', 'proteinG', 'carbsG', 'fatG'])
             && value.keys().hasAll(['kcal', 'proteinG', 'carbsG', 'fatG']);
    }

    // All four values known: a planned meal's values times the portion.
    function isNutritionValues(value) {
      return isNutrientKeys(value)
             && isQuantity(value.kcal) && isQuantity(value.proteinG)
             && isQuantity(value.carbsG) && isQuantity(value.fatG);
    }

    // A stated estimate: kcal required, a macro is a number or null (unknown).
    function isNutritionEstimate(value) {
      return isNutrientKeys(value)
             && isQuantity(value.kcal)
             && (value.proteinG == null || isQuantity(value.proteinG))
             && (value.carbsG == null || isQuantity(value.carbsG))
             && (value.fatG == null || isQuantity(value.fatG));
    }

    // Text a person reads: says something. No length policy here.
    function isDisplayText(value) {
      return value is string && value.trim().size() > 0;
    }

    function entryCommonKeys() {
      return ['schemaVersion', 'entryId', 'kind', 'date', 'slotId', 'recording',
              'estimateBasis', 'nutritionEstimate', 'revision', 'status', 'appliedIntentIds'];
    }

    function hasExactKeys(entry, keys) {
      return entry.keys().hasOnly(keys) && entry.keys().hasAll(keys);
    }

    // schemaVersion, entryId, kind, date and slotId, consistent with the
    // document id: `slot:{date}:{slotId}` or `extra:{uuid}` (custom only).
    function isEntryIdentity(docId, entry) {
      return entry.schemaVersion == 2
             && entry.entryId == docId
             && isNutritionDate(entry.date)
             && ((entry.kind == 'slot'
                  && isNutritionSlotId(entry.slotId)
                  && docId == 'slot:' + entry.date + ':' + entry.slotId)
                 || (entry.kind == 'extra'
                  && entry.slotId == null
                  && entry.recording == 'custom'
                  && docId.matches('^extra:' + uuidPattern() + '$')));
    }

    // Exactly one recording variant, with exactly its fields.
    function isEntryRecording(entry) {
      return (entry.recording == 'plannedMeal'
              && hasExactKeys(entry, entryCommonKeys().concat(['planId', 'name', 'portion']))
              && isNutritionDocId(entry.planId)
              && isDisplayText(entry.name)
              && entry.estimateBasis == 'planMealTimesPortion'
              && isQuantity(entry.portion) && entry.portion > 0
              && isNutritionValues(entry.nutritionEstimate))
          || (entry.recording == 'skip'
              && hasExactKeys(entry, entryCommonKeys())
              && entry.estimateBasis == 'none'
              && entry.nutritionEstimate == null)
          || (entry.recording == 'custom'
              && hasExactKeys(entry, entryCommonKeys().concat(['name']))
              && isDisplayText(entry.name)
              && entry.estimateBasis == 'userStated'
              && isNutritionEstimate(entry.nutritionEstimate));
    }

    function isEntryMetadata(entry) {
      return entry.revision is int && entry.revision >= 1
             && entry.status in ['active', 'removed']
             && entry.appliedIntentIds is list
             && entry.appliedIntentIds.size() >= 1
             && entry.appliedIntentIds.size() <= 20;
    }

    function isValidEntry(docId, entry) {
      return isEntryIdentity(docId, entry) && isEntryRecording(entry) && isEntryMetadata(entry);
    }

    // A new entry: revision 1, active (never born a tombstone), applied by
    // exactly one intent.
    function isNutritionEntryCreate(docId, next) {
      return isValidEntry(docId, next)
             && next.revision == 1
             && next.status == 'active'
             && next.appliedIntentIds.size() == 1
             && isIntentId(next.appliedIntentIds[0]);
    }

    // One applied write adds exactly one new intent id at the end, dropping
    // the oldest only once the ring holds 20.
    function isIntentRingStep(prev, next) {
      let fresh = next[next.size() - 1];
      return isIntentId(fresh)
             && !(fresh in prev)
             && (prev.size() < 20
                   ? next == prev.concat([fresh])
                   : next == prev[1:20].concat([fresh]));
    }

    // Identity fixed, revision exactly +1, ring stepped, the result valid.
    // A removal only turns an active entry into a tombstone and keeps its
    // snapshot; a tombstone may be recorded again as an active entry.
    function isNutritionEntryUpdate(docId, prev, next) {
      return isValidEntry(docId, next)
             && next.schemaVersion == prev.schemaVersion
             && next.entryId == prev.entryId
             && next.kind == prev.kind
             && next.date == prev.date
             && next.slotId == prev.slotId
             && prev.revision is int
             && next.revision == prev.revision + 1
             && prev.appliedIntentIds is list
             && isIntentRingStep(prev.appliedIntentIds, next.appliedIntentIds)
             && (next.status == 'active'
                 || (prev.status == 'active'
                     && next.diff(prev).affectedKeys().hasOnly(['status', 'revision', 'appliedIntentIds'])));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // A new profile may not arrive with an authorization field already in it.
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(protectedFields());

      // `affectedKeys()` covers added, removed and changed keys alike, so this
      // one condition refuses introducing a role, escalating an existing one,
      // and dropping one — including via a full-document overwrite. Writing the
      // identical value back is not an affected key, so ordinary profile saves
      // are unaffected.
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(protectedFields());

      // Unchanged from production. No client path deletes a profile document
      // today (there is no self-service account deletion), so removing this
      // would be a behaviour change without a security benefit.
      allow delete: if isOwner(userId);

      // User-scoped data: workout_plans, workout_logs, ai_logs and anything
      // else under the profile, except Nutrition. Unchanged from production
      // for every other name — the protection above is scoped to the profile
      // document and must not leak down here and start refusing legitimate
      // writes.
      //
      // Nutrition is carved out at both levels, by name, so neither grant can
      // ever reach it; its access is spelled out in the blocks further down.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId)
                           && !isNutritionCollection(subcollection);

        // workout_set_logs under a workout_log. The parent check keeps nested
        // documents under a Nutrition collection out of this grant too.
        match /{nested}/{nestedDocId} {
          allow read, write: if isOwner(userId)
                             && !isNutritionCollection(subcollection)
                             && !isNutritionCollection(nested);
        }
      }

      // Nutrition V2. Server-owned: the owner reads, and no client writes,
      // because nothing here allows one. Cloud Functions write through the
      // Admin SDK, which bypasses rules. The one exception is
      // `nutrition_v2_entries`, which an adult owner creates and updates
      // through a narrowly validated compare-and-set write (see
      // `isNutritionEntryCreate` / `isNutritionEntryUpdate`). Any other
      // `nutrition_v2_*` name, and anything nested under these, matches no
      // allow and is denied.
      match /nutrition_v2_state/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_targets/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_plans/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_slots/{docId} {
        allow read: if isOwner(userId);
      }

      // Recorded entries: owner-readable, owner-writable by an adult, never
      // deletable. A taken-back entry is a `removed` tombstone, not a delete.
      match /nutrition_v2_entries/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isNutritionAdult(userId)
                      && isNutritionEntryCreate(docId, request.resource.data);
        allow update: if isOwner(userId)
                      && isNutritionAdult(userId)
                      && isNutritionEntryUpdate(docId, resource.data, request.resource.data);
      }

      match /nutrition_v2_generations/{docId} {
        allow read: if isOwner(userId);
      }

      // Legacy Nutrition: read-only for clients. The legacy view still reads
      // its latest plan; nothing on the client may create, change or delete
      // one any more.
      match /nutrition_plans/{docId} {
        allow read: if isOwner(userId);
      }
    }

    // The shared exercise catalogue: readable by any signed-in user, written
    // only by the Admin SDK. Unchanged from production.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /*
      Server-owned AI bookkeeping. Denied to every client, read and write.

      These are not private-by-obscurity: `_ai_quota` decides whether a paid
      model call may happen, so a client that could edit it could spend money
      without limit; `_ai_logs` is the record of what was spent, worthless if
      the person it bills can rewrite it; `_ai_operations` is what stops one
      click becoming two charges.

      The Admin SDK bypasses rules entirely, so Cloud Functions still read and
      write all three. Nothing here needs relaxing to let a server work — if a
      write cannot be done by a client, it belongs in a callable.

      An unmatched path is denied anyway; these blocks are explicit so the
      intent survives the next person reading the file.
    */
    match /_ai_quota/{document=**} {
      allow read, write: if false;
    }

    match /_ai_logs/{document=**} {
      allow read, write: if false;
    }

    match /_ai_operations/{document=**} {
      allow read, write: if false;
    }
  }
}
