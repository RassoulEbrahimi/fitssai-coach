// Firestore Security Rules for the FitssAI Coach project (fitssai-coach).
//
// Captured from the deployed production rules on 2026-08-27. The owner-access
// model below is that capture, unchanged. The one deliberate difference is the
// protection of authorization fields on /users/{userId}, which closes a
// privilege-escalation path: the previous `allow write` let a signed-in user
// set `role: "admin"` on their own profile straight from the client SDK.
//
// Since then, Nutrition has been carved out of the generic owner wildcard
// under /users/{userId}: Nutrition V2 (`nutrition_v2_*`) and legacy
// `nutrition_plans` are owner-readable and closed to client writes.
//
// Everything here is exercised by rules-tests/firestore.rules.test.ts against
// the real rules engine in the Firestore emulator. Those tests were first run
// against the captured production rules, where the eight role-escalation cases
// failed — the vulnerability, reproduced before it was fixed.
//
// Note: the Admin SDK, and therefore Cloud Functions, bypasses these rules
// entirely. Server-side code needs no allowance here, and these rules must
// never be loosened to accommodate it.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields that decide what someone is allowed to do. No client path writes
    // any of them — the app's profile writes are explicit field lists and
    // onboarding creates the document without a role — so a client write that
    // touches one did not come from the app.
    //
    // `role` is the field the app actually reads. The rest are the spellings a
    // future feature might reach for; listing them costs nothing and means the
    // rule does not have to be revisited to stay correct.
    function protectedFields() {
      return ['role', 'admin', 'isAdmin', 'roles', 'permissions'];
    }

    // Nutrition V2 owns every user subcollection whose name starts with
    // `nutrition_v2_`, today's six and any added later. Legacy Nutrition's
    // `nutrition_plans` is closed to client writes alongside it.
    //
    // Rules have no deny precedence: `allow` conditions on overlapping matches
    // are OR-combined, so an explicit read-only block below cannot take back a
    // write the generic owner wildcard already grants. The wildcard itself has
    // to leave these names out, and this predicate is how it does.
    function isNutritionV2Collection(name) {
      return name.matches('nutrition_v2_.*');
    }

    function isNutritionCollection(name) {
      return isNutritionV2Collection(name) || name == 'nutrition_plans';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // A new profile may not arrive with an authorization field already in it.
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(protectedFields());

      // `affectedKeys()` covers added, removed and changed keys alike, so this
      // one condition refuses introducing a role, escalating an existing one,
      // and dropping one — including via a full-document overwrite. Writing the
      // identical value back is not an affected key, so ordinary profile saves
      // are unaffected.
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(protectedFields());

      // Unchanged from production. No client path deletes a profile document
      // today (there is no self-service account deletion), so removing this
      // would be a behaviour change without a security benefit.
      allow delete: if isOwner(userId);

      // User-scoped data: workout_plans, workout_logs, ai_logs and anything
      // else under the profile, except Nutrition. Unchanged from production
      // for every other name — the protection above is scoped to the profile
      // document and must not leak down here and start refusing legitimate
      // writes.
      //
      // Nutrition is carved out at both levels, by name, so neither grant can
      // ever reach it; its access is spelled out in the blocks further down.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId)
                           && !isNutritionCollection(subcollection);

        // workout_set_logs under a workout_log. The parent check keeps nested
        // documents under a Nutrition collection out of this grant too.
        match /{nested}/{nestedDocId} {
          allow read, write: if isOwner(userId)
                             && !isNutritionCollection(subcollection)
                             && !isNutritionCollection(nested);
        }
      }

      // Nutrition V2. Server-owned in this slice: the owner reads, and no
      // client writes, because nothing here allows one. Cloud Functions write
      // through the Admin SDK, which bypasses rules. Entries get a narrowly
      // validated client write in a later slice; until then they are
      // read-only like the rest. Any other `nutrition_v2_*` name, and anything
      // nested under these, matches no allow and is denied.
      match /nutrition_v2_state/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_targets/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_plans/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_slots/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_entries/{docId} {
        allow read: if isOwner(userId);
      }

      match /nutrition_v2_generations/{docId} {
        allow read: if isOwner(userId);
      }

      // Legacy Nutrition: read-only for clients. The legacy view still reads
      // its latest plan; nothing on the client may create, change or delete
      // one any more.
      match /nutrition_plans/{docId} {
        allow read: if isOwner(userId);
      }
    }

    // The shared exercise catalogue: readable by any signed-in user, written
    // only by the Admin SDK. Unchanged from production.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /*
      Server-owned AI bookkeeping. Denied to every client, read and write.

      These are not private-by-obscurity: `_ai_quota` decides whether a paid
      model call may happen, so a client that could edit it could spend money
      without limit; `_ai_logs` is the record of what was spent, worthless if
      the person it bills can rewrite it; `_ai_operations` is what stops one
      click becoming two charges.

      The Admin SDK bypasses rules entirely, so Cloud Functions still read and
      write all three. Nothing here needs relaxing to let a server work — if a
      write cannot be done by a client, it belongs in a callable.

      An unmatched path is denied anyway; these blocks are explicit so the
      intent survives the next person reading the file.
    */
    match /_ai_quota/{document=**} {
      allow read, write: if false;
    }

    match /_ai_logs/{document=**} {
      allow read, write: if false;
    }

    match /_ai_operations/{document=**} {
      allow read, write: if false;
    }
  }
}
